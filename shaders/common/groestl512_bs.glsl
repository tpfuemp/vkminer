    uint t18 = (t2 ^ (t5 ^ t16));
    uint t20 = (t7 ^ (t10 ^ t16));
    uint t21 = (y20 ^ (t4 ^ t14));
    uint t22 = (y8 ^ (y10 ^ t18));
    uint t23 = (y21 ^ (t9 ^ t14));
    uint t24 = (x0 ^ (y16 ^ t20));
    uint t26 = (t21 & t23);
    uint t27 = (t24 ^ t26);
    uint t29 = ((t21 & t27) ^ (t22 & ~t27));
    uint t31 = (t22 ^ t26);
    uint t33 = ((t23 & t31) ^ (t24 & ~t31));
    uint t36 = (t24 & (t27 ^ t33));
    uint t37 = (t23 ^ (t33 ^ t36));
    uint t39 = (t29 & (t27 ^ t36));
    uint t40 = (t21 ^ (t22 ^ t39));
    uint t41 = (t37 ^ t40);
    uint t42 = (t29 ^ t33);
    uint t43 = (t29 ^ t40);
    uint t44 = (t33 ^ t37);
    uint t45 = (t41 ^ t42);
    uint z2 = (x7 & t33);
    uint z3 = (y16 & t43);
    uint z4 = (y1 & t40);
    uint z5 = (t29 & (x7 ^ y11));
    uint z6 = (y11 & t42);
    uint z7 = (t45 & (y10 ^ y11));
    uint z8 = (y10 & t41);
    uint z10 = (y3 & t37);
    uint z11 = (t33 & (x3 ^ y1));
    uint z12 = (t43 & (x0 ^ x6));
    uint z13 = (t40 & (x6 ^ y1));
    uint z14 = (t29 & (x0 ^ y1));
    uint z15 = (t42 & (x0 ^ x3));
    uint z16 = (t45 & (x3 ^ x5));
    uint t46 = (z15 ^ z16);
    uint t48 = (z5 ^ z13);
    uint t49 = (z10 ^ (y12 & t44));
    uint t53 = (z3 ^ (y15 & t44));
    uint t55 = (z16 ^ (y8 & t41));
    uint t57 = (z2 ^ (z12 ^ t53));
    uint t58 = (z4 ^ t46);
    uint t59 = (z3 ^ (z6 ^ z7));
    uint t62 = (z7 ^ (z8 ^ t58));
    uint t63 = (t49 ^ t58);
    uint t64 = (z4 ^ t59);
    uint t65 = (z14 ^ (t57 ^ t62));
    uint t66 = (t63 ^ (y6 & t37));
    uint s0 = (t59 ^ t63);
    uint s6 = (~(z12) ^ (t48 ^ t62));
    uint s7 = (~(t46) ^ (t48 ^ t57));
    uint s3 = (t53 ^ t66);
    uint s4 = (z2 ^ (z5 ^ t66));
    uint s5 = (z10 ^ (z11 ^ t65));
    uint s1 = (~(t53) ^ (t64 ^ t66));
    uint s2 = (~(t55) ^ (t64 ^ t65));
    q[7] = s0;
    q[6] = s1;
    q[5] = s2;
    q[4] = s3;
    q[3] = s4;
    q[2] = s5;
    q[1] = s6;
    q[0] = s7;
