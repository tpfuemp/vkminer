    s[56] = o56;
    s[57] = o57;
    s[58] = o58;
    s[59] = o59;
    s[60] = o60;
    s[61] = o61;
    s[62] = o62;
    s[63] = o63;
}

// One round of P (q false) or Q (q true). Run-time selection keeps a single
// copy of the body in the binary.
void groestl_bs_round(inout uint s[64], uint r, bool q)
{
    uint qm = q ? 0xffffffffu : 0u, pm = ~qm;

    // AddRoundConstant: Q complements every byte, then both add
    // (column << 4) ^ r, P to row 0 and Q to row 7.
    for (uint k = 0u; k < 64u; k++)
        s[k] ^= qm;
    { uint rc = 0u - ((r >> 0u) & 1u); s[0] ^= pm & rc; s[56] ^= qm & rc; }
    { uint rc = 0u - ((r >> 1u) & 1u); s[1] ^= pm & rc; s[57] ^= qm & rc; }
    { uint rc = 0u - ((r >> 2u) & 1u); s[2] ^= pm & rc; s[58] ^= qm & rc; }
    { uint rc = 0u - ((r >> 3u) & 1u); s[3] ^= pm & rc; s[59] ^= qm & rc; }
    s[4] ^= pm & 0xCCCCCCCCu; s[60] ^= qm & 0xCCCCCCCCu;
    s[5] ^= pm & 0xF0F0F0F0u; s[61] ^= qm & 0xF0F0F0F0u;
    s[6] ^= pm & 0xFF00FF00u; s[62] ^= qm & 0xFF00FF00u;
    s[7] ^= pm & 0xFFFF0000u; s[63] ^= qm & 0xFFFF0000u;

    // ShiftBytes: row i moves left by its offset, two bit positions a column.
    { uint n = q ? 2u : 0u;
      s[0] = (s[0] >> n) | (s[0] << ((32u - n) & 31u));
      s[1] = (s[1] >> n) | (s[1] << ((32u - n) & 31u));
      s[2] = (s[2] >> n) | (s[2] << ((32u - n) & 31u));
      s[3] = (s[3] >> n) | (s[3] << ((32u - n) & 31u));
      s[4] = (s[4] >> n) | (s[4] << ((32u - n) & 31u));
      s[5] = (s[5] >> n) | (s[5] << ((32u - n) & 31u));
      s[6] = (s[6] >> n) | (s[6] << ((32u - n) & 31u));
      s[7] = (s[7] >> n) | (s[7] << ((32u - n) & 31u));
    }
    { uint n = q ? 6u : 2u;
      s[8] = (s[8] >> n) | (s[8] << ((32u - n) & 31u));
      s[9] = (s[9] >> n) | (s[9] << ((32u - n) & 31u));
      s[10] = (s[10] >> n) | (s[10] << ((32u - n) & 31u));
      s[11] = (s[11] >> n) | (s[11] << ((32u - n) & 31u));
      s[12] = (s[12] >> n) | (s[12] << ((32u - n) & 31u));
      s[13] = (s[13] >> n) | (s[13] << ((32u - n) & 31u));
      s[14] = (s[14] >> n) | (s[14] << ((32u - n) & 31u));
      s[15] = (s[15] >> n) | (s[15] << ((32u - n) & 31u));
    }
    { uint n = q ? 10u : 4u;
      s[16] = (s[16] >> n) | (s[16] << ((32u - n) & 31u));
      s[17] = (s[17] >> n) | (s[17] << ((32u - n) & 31u));
      s[18] = (s[18] >> n) | (s[18] << ((32u - n) & 31u));
      s[19] = (s[19] >> n) | (s[19] << ((32u - n) & 31u));
      s[20] = (s[20] >> n) | (s[20] << ((32u - n) & 31u));
      s[21] = (s[21] >> n) | (s[21] << ((32u - n) & 31u));
      s[22] = (s[22] >> n) | (s[22] << ((32u - n) & 31u));
      s[23] = (s[23] >> n) | (s[23] << ((32u - n) & 31u));
    }
    { uint n = q ? 22u : 6u;
      s[24] = (s[24] >> n) | (s[24] << ((32u - n) & 31u));
      s[25] = (s[25] >> n) | (s[25] << ((32u - n) & 31u));
      s[26] = (s[26] >> n) | (s[26] << ((32u - n) & 31u));
      s[27] = (s[27] >> n) | (s[27] << ((32u - n) & 31u));
      s[28] = (s[28] >> n) | (s[28] << ((32u - n) & 31u));
      s[29] = (s[29] >> n) | (s[29] << ((32u - n) & 31u));
      s[30] = (s[30] >> n) | (s[30] << ((32u - n) & 31u));
      s[31] = (s[31] >> n) | (s[31] << ((32u - n) & 31u));
    }
    { uint n = q ? 0u : 8u;
      s[32] = (s[32] >> n) | (s[32] << ((32u - n) & 31u));
      s[33] = (s[33] >> n) | (s[33] << ((32u - n) & 31u));
      s[34] = (s[34] >> n) | (s[34] << ((32u - n) & 31u));
      s[35] = (s[35] >> n) | (s[35] << ((32u - n) & 31u));
      s[36] = (s[36] >> n) | (s[36] << ((32u - n) & 31u));
      s[37] = (s[37] >> n) | (s[37] << ((32u - n) & 31u));
      s[38] = (s[38] >> n) | (s[38] << ((32u - n) & 31u));
      s[39] = (s[39] >> n) | (s[39] << ((32u - n) & 31u));
    }
    { uint n = q ? 4u : 10u;
      s[40] = (s[40] >> n) | (s[40] << ((32u - n) & 31u));
      s[41] = (s[41] >> n) | (s[41] << ((32u - n) & 31u));
      s[42] = (s[42] >> n) | (s[42] << ((32u - n) & 31u));
      s[43] = (s[43] >> n) | (s[43] << ((32u - n) & 31u));
      s[44] = (s[44] >> n) | (s[44] << ((32u - n) & 31u));
      s[45] = (s[45] >> n) | (s[45] << ((32u - n) & 31u));
      s[46] = (s[46] >> n) | (s[46] << ((32u - n) & 31u));
      s[47] = (s[47] >> n) | (s[47] << ((32u - n) & 31u));
    }
    { uint n = q ? 8u : 12u;
      s[48] = (s[48] >> n) | (s[48] << ((32u - n) & 31u));
      s[49] = (s[49] >> n) | (s[49] << ((32u - n) & 31u));
      s[50] = (s[50] >> n) | (s[50] << ((32u - n) & 31u));
      s[51] = (s[51] >> n) | (s[51] << ((32u - n) & 31u));
      s[52] = (s[52] >> n) | (s[52] << ((32u - n) & 31u));
      s[53] = (s[53] >> n) | (s[53] << ((32u - n) & 31u));
      s[54] = (s[54] >> n) | (s[54] << ((32u - n) & 31u));
      s[55] = (s[55] >> n) | (s[55] << ((32u - n) & 31u));
    }
    { uint n = q ? 12u : 22u;
      s[56] = (s[56] >> n) | (s[56] << ((32u - n) & 31u));
      s[57] = (s[57] >> n) | (s[57] << ((32u - n) & 31u));
      s[58] = (s[58] >> n) | (s[58] << ((32u - n) & 31u));
      s[59] = (s[59] >> n) | (s[59] << ((32u - n) & 31u));
      s[60] = (s[60] >> n) | (s[60] << ((32u - n) & 31u));
      s[61] = (s[61] >> n) | (s[61] << ((32u - n) & 31u));
      s[62] = (s[62] >> n) | (s[62] << ((32u - n) & 31u));
      s[63] = (s[63] >> n) | (s[63] << ((32u - n) & 31u));
    }

    // SubBytes, row by row.
    { uint t[8] = uint[8](s[0], s[1], s[2], s[3], s[4], s[5], s[6], s[7]); groestl_bs_sbox(t);
      s[0] = t[0]; s[1] = t[1]; s[2] = t[2]; s[3] = t[3]; s[4] = t[4]; s[5] = t[5]; s[6] = t[6]; s[7] = t[7]; }
    { uint t[8] = uint[8](s[8], s[9], s[10], s[11], s[12], s[13], s[14], s[15]); groestl_bs_sbox(t);
      s[8] = t[0]; s[9] = t[1]; s[10] = t[2]; s[11] = t[3]; s[12] = t[4]; s[13] = t[5]; s[14] = t[6]; s[15] = t[7]; }
    { uint t[8] = uint[8](s[16], s[17], s[18], s[19], s[20], s[21], s[22], s[23]); groestl_bs_sbox(t);
      s[16] = t[0]; s[17] = t[1]; s[18] = t[2]; s[19] = t[3]; s[20] = t[4]; s[21] = t[5]; s[22] = t[6]; s[23] = t[7]; }
    { uint t[8] = uint[8](s[24], s[25], s[26], s[27], s[28], s[29], s[30], s[31]); groestl_bs_sbox(t);
      s[24] = t[0]; s[25] = t[1]; s[26] = t[2]; s[27] = t[3]; s[28] = t[4]; s[29] = t[5]; s[30] = t[6]; s[31] = t[7]; }
    { uint t[8] = uint[8](s[32], s[33], s[34], s[35], s[36], s[37], s[38], s[39]); groestl_bs_sbox(t);
      s[32] = t[0]; s[33] = t[1]; s[34] = t[2]; s[35] = t[3]; s[36] = t[4]; s[37] = t[5]; s[38] = t[6]; s[39] = t[7]; }
    { uint t[8] = uint[8](s[40], s[41], s[42], s[43], s[44], s[45], s[46], s[47]); groestl_bs_sbox(t);
      s[40] = t[0]; s[41] = t[1]; s[42] = t[2]; s[43] = t[3]; s[44] = t[4]; s[45] = t[5]; s[46] = t[6]; s[47] = t[7]; }
    { uint t[8] = uint[8](s[48], s[49], s[50], s[51], s[52], s[53], s[54], s[55]); groestl_bs_sbox(t);
      s[48] = t[0]; s[49] = t[1]; s[50] = t[2]; s[51] = t[3]; s[52] = t[4]; s[53] = t[5]; s[54] = t[6]; s[55] = t[7]; }
    { uint t[8] = uint[8](s[56], s[57], s[58], s[59], s[60], s[61], s[62], s[63]); groestl_bs_sbox(t);
      s[56] = t[0]; s[57] = t[1]; s[58] = t[2]; s[59] = t[3]; s[60] = t[4]; s[61] = t[5]; s[62] = t[6]; s[63] = t[7]; }

    groestl_bs_mix(s);
}

