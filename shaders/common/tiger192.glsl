// Tiger, the original with 0x01 padding, over a 64- or 80-byte message.
// SPDX-License-Identifier: GPL-3.0-or-later
//
// Three 64-bit chaining words and four S-boxes, all held as uvec2 pairs (.x
// the low half), so message and digest words are little-endian reads. Tiger
// adds, subtracts and multiplies; a module that defines VKMINER_TIGER_INT64
// does those three through uint64_t and needs shaderInt64, the others carry
// by hand. Same rule as sha512.glsl: never `+` a pair, use tiger_add().
// The S-boxes live in workgroup memory: call tiger192_table_load() first.
// src/core/tiger192.c is the scalar reference and generates the boxes; the
// constants below were printed from it.

#ifndef VKMINER_SHADERS_COMMON_TIGER192_GLSL_INCLUDED
