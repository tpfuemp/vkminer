shared uvec2 tiger_t[1024];

// Fills the boxes, lane `lane` of `width`, and waits for the workgroup.
void tiger192_table_load(uint lane, uint width)
{
    for (uint i = lane; i < 1024u; i += width)
        tiger_t[i] = uvec2(kTiger192Sbox[2u * i], kTiger192Sbox[2u * i + 1u]);
    barrier();
}

#ifdef VKMINER_TIGER_INT64

uint64_t tiger_wide(uvec2 a) { return uint64_t(a.x) | (uint64_t(a.y) << 32); }
uvec2 tiger_pair(uint64_t a) { return uvec2(uint(a), uint(a >> 32)); }

uvec2 tiger_add(uvec2 a, uvec2 b) { return tiger_pair(tiger_wide(a) + tiger_wide(b)); }
uvec2 tiger_sub(uvec2 a, uvec2 b) { return tiger_pair(tiger_wide(a) - tiger_wide(b)); }
uvec2 tiger_mul(uvec2 a, uint m)  { return tiger_pair(tiger_wide(a) * uint64_t(m)); }

#else

uvec2 tiger_add(uvec2 a, uvec2 b)
{
    uint lo = a.x + b.x;
    return uvec2(lo, a.y + b.y + (lo < a.x ? 1u : 0u));
}

uvec2 tiger_sub(uvec2 a, uvec2 b)
{
    return uvec2(a.x - b.x, a.y - b.y - (a.x < b.x ? 1u : 0u));
}

// a times 5, 7 or 9, as a shift and an add or subtract.
uvec2 tiger_mul(uvec2 a, uint m)
{
    uvec2 s = m == 5u ? uvec2(a.x << 2, (a.y << 2) | (a.x >> 30))
                      : uvec2(a.x << 3, (a.y << 3) | (a.x >> 29));
    return m == 7u ? tiger_sub(s, a) : tiger_add(s, a);
}

#endif

uvec2 tiger_shl(uvec2 a, uint n) { return uvec2(a.x << n, (a.y << n) | (a.x >> (32u - n))); }
uvec2 tiger_shr(uvec2 a, uint n) { return uvec2((a.x >> n) | (a.y << (32u - n)), a.y >> n); }

#define TIGER_T(box, v, n) \
    tiger_t[256u * (box) + ((((n) < 4u ? (v).x : (v).y) >> (8u * ((n) & 3u))) & 0xffu)]

#define TIGER_ROUND(a, b, c, x, mul)                                          \
    c ^= (x);                                                                 \
    a = tiger_sub(a, TIGER_T(0u, c, 0u) ^ TIGER_T(1u, c, 2u)                 \
                   ^ TIGER_T(2u, c, 4u) ^ TIGER_T(3u, c, 6u));               \
    b = tiger_add(b, TIGER_T(3u, c, 1u) ^ TIGER_T(2u, c, 3u)                 \
                   ^ TIGER_T(1u, c, 5u) ^ TIGER_T(0u, c, 7u));               \
    b = tiger_mul(b, mul)

#define TIGER_PASS(a, b, c, x, mul)                                           \
    TIGER_ROUND(a, b, c, x[0], mul); TIGER_ROUND(b, c, a, x[1], mul);         \
    TIGER_ROUND(c, a, b, x[2], mul); TIGER_ROUND(a, b, c, x[3], mul);         \
    TIGER_ROUND(b, c, a, x[4], mul); TIGER_ROUND(c, a, b, x[5], mul);         \
    TIGER_ROUND(a, b, c, x[6], mul); TIGER_ROUND(b, c, a, x[7], mul)

void tiger192_key_schedule(inout uvec2 x[8])
{
    x[0] = tiger_sub(x[0], x[7] ^ uvec2(0xa5a5a5a5u, 0xa5a5a5a5u));
    x[1] ^= x[0];
    x[2] = tiger_add(x[2], x[1]);
    x[3] = tiger_sub(x[3], x[2] ^ tiger_shl(~x[1], 19u));
    x[4] ^= x[3];
    x[5] = tiger_add(x[5], x[4]);
    x[6] = tiger_sub(x[6], x[5] ^ tiger_shr(~x[4], 23u));
    x[7] ^= x[6];
    x[0] = tiger_add(x[0], x[7]);
    x[1] = tiger_sub(x[1], x[0] ^ tiger_shl(~x[7], 19u));
    x[2] ^= x[1];
    x[3] = tiger_add(x[3], x[2]);
    x[4] = tiger_sub(x[4], x[3] ^ tiger_shr(~x[2], 23u));
    x[5] ^= x[4];
    x[6] = tiger_add(x[6], x[5]);
    x[7] = tiger_sub(x[7], x[6] ^ uvec2(0x89abcdefu, 0x01234567u));
}

void tiger192_compress(inout uvec2 h[3], uvec2 x[8])
{
    uvec2 a = h[0], b = h[1], c = h[2];

    TIGER_PASS(a, b, c, x, 5u);
    tiger192_key_schedule(x);
    TIGER_PASS(c, a, b, x, 7u);
    tiger192_key_schedule(x);
    TIGER_PASS(b, c, a, x, 9u);

    h[0] = a ^ h[0];
    h[1] = tiger_sub(b, h[1]);
    h[2] = tiger_add(c, h[2]);
}

// Tiger of the first `words` words of `msg`, 16 or 20; a constant at every
// call site. Two compressions either way: the first 64 bytes, then the rest
// with 0x01 after it and the bit count in the last eight bytes. Six words out.
void tiger192_hash(uint msg[20], uint words, out uint h[6])
{
    uvec2 st[3] = uvec2[3](uvec2(0x89abcdefu, 0x01234567u),
                           uvec2(0x76543210u, 0xfedcba98u),
                           uvec2(0xc3b2e187u, 0xf096a5b4u));
    uvec2 x[8];
    for (uint i = 0u; i < 8u; i++)
        x[i] = uvec2(msg[2u * i], msg[2u * i + 1u]);
    tiger192_compress(st, x);

    uint w[16];
    for (uint k = 0u; k < 16u; k++)
        w[k] = k + 16u < words ? msg[k + 16u] : 0u;
    w[words - 16u] = 0x01u;
    w[14] = 32u * words;
    for (uint i = 0u; i < 8u; i++)
        x[i] = uvec2(w[2u * i], w[2u * i + 1u]);
    tiger192_compress(st, x);

    for (uint i = 0u; i < 3u; i++) {
        h[2u * i] = st[i].x;
        h[2u * i + 1u] = st[i].y;
    }
}

