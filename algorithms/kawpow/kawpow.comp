// A ProgPoW fork, interpreted: sixteen invocations per nonce, reading the
// program.
// SPDX-License-Identifier: GPL-3.0-or-later
//
// ProgPoW's inner loop is regenerated every few blocks, so a kernel either
// bakes the period in and is rebuilt every few minutes or reads the program as
// data. This one reads it as data: 131 words in workgroup memory, an index and
// a selector at a time. That makes it the slow one and the control -- what
// every faster spelling is compared against, and the only kernel here that
// needs nothing of a device but Vulkan 1.1.
//
// Which fork it is arrives as specialization constants and nothing else; see
// shaders/common/progpow_params.glsl.
//
// Sixteen invocations per nonce, because ProgPoW's mix is 16 lanes wide and
// each round mixes across them. The backend launches `count * lanes`
// invocations and counts nothing but nonces; see KernelSpec::lanes.
//
// The lanes meet in exactly two places, both in kawpow_lanes.glsl, which also
// spells them as subgroup shuffles. This kernel always takes the portable one:
// a control that varied with the device would compare two unknowns.
//
// The program is generated here rather than uploaded -- a hundred-odd KISS99
// draws from one number, done by one invocation per workgroup while the rest
// wait on a barrier they were going to wait on anyway. The alternative is a
// buffer the host rewrites every three minutes.

#version 450

#extension GL_GOOGLE_include_directive : require

#include "shaders/common/bits.glsl"
#include "shaders/common/candidates.glsl"

// The DAG. Binding 0 is the candidate buffer, so the table starts after it.
#define SHARED_TABLE_BINDING 1
#include "shaders/common/shared_table.glsl"

#include "shaders/common/keccak_f800.glsl"

layout(local_size_x_id = 0) in;

// 92 bytes, against a guaranteed minimum of 128. Mirrored by ProgPowPush in
// kawpow.cpp, which asserts its own size and offsets.
layout(push_constant) uniform Push {
    uint header[8];    // the 32-byte header hash, little-endian words
    uint target[8];    // as fulltest() compares: little-endian, most significant last
    uint nonce_lo;     // the nonce is 64 bits and the pool owns its top two bytes
    uint nonce_hi;
    uint count;        // nonces to test, which is a sixteenth of the invocations
    uint capacity;     // candidates the result buffer can hold
    uint period_lo;    // block height / the period length: the program's input
    uint period_hi;
    uint dag_lines;    // 256-byte lines in the table bound above
} push;

// ------------------------------------------------------------- the shape of it
//
// Which fork this is, and where the program's words sit. The host has the same
// numbers in kawpow_params.h and kawpow_program.h.
#include "shaders/common/progpow_params.glsl"

// How the lanes talk. Included here rather than at the top because it is
// written in terms of kLanes, declared just above.
#include "shaders/common/kawpow_lanes.glsl"

// ------------------------------------------------------------ workgroup memory
//
// The program, built once per workgroup by invocation 0 while the rest wait on
// the barrier they were going to wait on anyway.

shared uint prog[kProgramWords];

// ------------------------------------------------------------------- the RNGs
//
// FNV-1a and KISS99, the whole source of randomness in KawPoW: this pair
// generates the program, and the same pair seeded differently fills the mix
// registers a hash starts from. The KISS99 state is a global because it is
// per-invocation either way and the two users never overlap.

uint fnv1a(uint u, uint v)
{
    return (u ^ v) * kFnvPrime;
}

uint g_z, g_w, g_jsr, g_jcong;

void kiss99_seed(uint z, uint w, uint jsr, uint jcong)
{
    g_z = z;
    g_w = w;
    g_jsr = jsr;
    g_jcong = jcong;
}

uint kiss99()
{
    g_z = 36969u * (g_z & 0xffffu) + (g_z >> 16);
    g_w = 18000u * (g_w & 0xffffu) + (g_w >> 16);

    g_jcong = 69069u * g_jcong + 1234567u;

    g_jsr ^= g_jsr << 17;
    g_jsr ^= g_jsr >> 13;
    g_jsr ^= g_jsr << 5;

    return (((g_z << 16) + g_w) ^ g_jcong) + g_jsr;
}

// ------------------------------------------------------------- the program
//
// The draw order is the specification: every value comes off one KISS99
// stream, so a call made in the wrong order -- or made at all -- changes every
// value after it. This is kawpow_program.cpp step for step, and the KAT
// compares the two.

// Sized for the widest fork and used a prefix at a time: an array a
// specialization constant is the length of is one no compiler will keep in
// registers.
uint dst_seq[kMaxRegs];
uint src_seq[kMaxRegs];
uint dst_counter;
uint src_counter;

uint next_dst()
{
    return dst_seq[(dst_counter++) % kRegs];
}

uint next_src()
{
    return src_seq[(src_counter++) % kRegs];
}

void build_program(uint period_lo, uint period_hi)
{
    uint z = fnv1a(kFnvOffsetBasis, period_lo);
    uint w = fnv1a(z, period_hi);
    uint jsr = fnv1a(w, period_lo);
    uint jcong = fnv1a(jsr, period_hi);
    kiss99_seed(z, w, jsr, jcong);

    // The whole program, not just the words this fork fills: the layout is the
    // widest fork's, and a narrower one leaves a tail no round reads. Zeroed so
    // that what it does not read is nothing in particular, which is what the
    // host does and what the KAT compares against.
    for (uint i = 0u; i < kProgramWords; i++)
        prog[i] = 0u;

    // Destinations and sources come from two shuffled permutations, so that
    // over one pass every register is written exactly once. Fisher-Yates from
    // the top down, and the two sequences are interleaved -- one swap of
    // each per step, destinations first.
    for (uint i = 0u; i < kRegs; i++) {
        dst_seq[i] = i;
        src_seq[i] = i;
    }
    for (uint i = kRegs; i > 1u; i--) {
        uint d = kiss99() % i;
        uint t0 = dst_seq[i - 1u];
        dst_seq[i - 1u] = dst_seq[d];
        dst_seq[d] = t0;

        uint s = kiss99() % i;
        uint t1 = src_seq[i - 1u];
        src_seq[i - 1u] = src_seq[s];
        src_seq[s] = t1;
    }

    dst_counter = 0u;
    src_counter = 0u;

    // The two kinds of operation are drawn interleaved, one of each per step
    // for as long as there are both. Drawing all the cache operations first
    // would produce a different and entirely plausible-looking program.
    uint steps = max(kCacheOps, kMathOps);
    for (uint i = 0u; i < steps; i++) {
        if (i < kCacheOps) {
            uint src = next_src();
            uint dst = next_dst();
            uint sel = kiss99();

            uint op = kCacheBase + i * kCacheWords;
            prog[op] = src;
            prog[op + 1u] = dst;
            prog[op + 2u] = sel;
        }
        if (i < kMathOps) {
            // Two *different* source registers from one draw: the second comes
            // from the range with the first removed and shifted back into
            // place, which is why it is not simply two independent numbers.
            uint src_rnd = kiss99() % (kRegs * (kRegs - 1u));
            uint src1 = src_rnd % kRegs;
            uint src2 = src_rnd / kRegs;
            if (src2 >= src1)
                src2++;

            uint sel1 = kiss99();
            uint dst = next_dst();
            uint sel2 = kiss99();

            uint op = kMathBase + i * kMathWords;
            prog[op] = src1;
            prog[op + 1u] = src2;
            prog[op + 2u] = sel1;
            prog[op + 3u] = dst;
            prog[op + 4u] = sel2;
        }
    }

    // The first DAG merge always writes register 0 and no draw is made for
    // it: register 0 is where the next round's line index is read from, so the
    // DAG has to reach it every round or the walk stops depending on the DAG.
    for (uint i = 0u; i < kDagLoads; i++) {
        uint dst = i == 0u ? 0u : next_dst();
        uint sel = kiss99();

        uint op = kDagBase + i * kDagWords;
        prog[op] = dst;
        prog[op + 1u] = sel;
    }
}

// ------------------------------------------------- what the program's words do
//
// Two operations, selected by a word of the program rather than by anything the
// hash computed, so every lane and every nonce takes the same branch. A kernel
// that resolved the selector at build time emits one instruction where this
// emits a switch.

// bits.glsl's rotate is undefined at zero and these are not: the shift count
// comes from the mix, so 0 and 32 both occur. The reference masks to five bits
// and so must this.
uint rot32(uint x, uint n)
{
    n &= 31u;
    return n == 0u ? x : ((x << n) | (x >> (32u - n)));
}

uint mul_hi32(uint a, uint b)
{
    uint hi, lo;
    umulExtended(a, b, hi, lo);
    return hi;
}

// findMSB is -1 for zero, which makes this 32 -- the count the reference's loop
// arrives at, and the one case a leading-zero count has to be told about.
uint clz32(uint x)
{
    return uint(31 - findMSB(x));
}

uint random_math(uint a, uint b, uint selector)
{
    switch (selector % 11u) {
    default:
    case 0u:  return a + b;
    case 1u:  return a * b;
    case 2u:  return mul_hi32(a, b);
    case 3u:  return min(a, b);
    case 4u:  return rot32(a, b);
    case 5u:  return rot32(a, 32u - (b & 31u));
    case 6u:  return a & b;
    case 7u:  return a | b;
    case 8u:  return a ^ b;
    case 9u:  return clz32(a) + clz32(b);
    case 10u: return bitCount(a) + bitCount(b);
    }
}

// Fold `b` into `a`, where `a` is assumed to carry the entropy: every case
// keeps it, which is why there is no `a & b` here and there is one above. The
// rotation comes from the selector's high bits and is forced into 1..31, so
// unlike random_math this one can never rotate by zero.
uint random_merge(uint a, uint b, uint selector)
{
    uint x = (selector >> 16) % 31u + 1u;

    switch (selector % 4u) {
    default:
    case 0u: return (a * 33u) + b;
    case 1u: return (a ^ b) * 33u;
    case 2u: return rot32(a, x) ^ b;
    case 3u: return rot32(a, 32u - x) ^ b;
    }
}

// ------------------------------------------------------------------ the kernel

void main()
{
    uint lane = kawpow_lane();
    uint nonce_index = kawpow_nonce_index();

    // No early return for the invocations past the end of the dispatch.
    // Every barrier below has to be reached by every invocation in the
    // workgroup, so the padding runs the whole hash and only the emit is
    // guarded. It hashes a nonce nobody asked for, in range and harmless.

    if (gl_LocalInvocationID.x == 0u)
        build_program(push.period_lo, push.period_hi);

    uint nonce_lo = push.nonce_lo + nonce_index;
    uint nonce_hi = push.nonce_hi + (nonce_lo < push.nonce_lo ? 1u : 0u);

    // Header, nonce and the fork's fifteen words, absorbed in one go: the state
    // is exactly 25 words and all of them are written, so there is no padding
    // rule and no rate. All sixteen lanes compute the same permutation rather
    // than one broadcasting it -- 22 rounds, against a barrier to save them.
    uint seed[25];
    for (uint i = 0u; i < 8u; i++)
        seed[i] = push.header[i];
    seed[8] = nonce_lo;
    seed[9] = nonce_hi;
    progpow_absorb_seed(seed);
    keccak_f800(seed);

    // The words this lane starts from. Each lane runs its own KISS99, seeded
    // from the digest and from the lane number, so the lanes start different
    // and no lane needs another to fill its registers.
    uint mix[kMaxRegs];
    {
        uint z = fnv1a(kFnvOffsetBasis, seed[0]);
        uint w = fnv1a(z, seed[1]);
        kiss99_seed(z, w, fnv1a(w, lane), fnv1a(fnv1a(w, lane), lane));
        for (uint i = 0u; i < kRegs; i++)
            mix[i] = kiss99();
    }

    uint steps = max(kCacheOps, kMathOps);

    for (uint r = 0u; r < kRounds; r++) {
        // The one value a round takes from the mix rather than from the
        // program, and the reason the DAG cannot be prefetched: lane r%16's
        // register 0, read by all sixteen. At r == 0 this is also what
        // publishes the program -- the barrier inside it is the only thing
        // between invocation 0's writes to prog[] and everyone's first read.
        uint line = kawpow_broadcast(mix[0], r % kLanes) % push.dag_lines;

        for (uint i = 0u; i < steps; i++) {
            if (i < kCacheOps) {
                uint op = kCacheBase + i * kCacheWords;
                uint dst = prog[op + 1u];
                uint offset = mix[prog[op]] % kL1Words;
                mix[dst] = random_merge(mix[dst], shared_word(offset),
                                        prog[op + 2u]);
            }
            if (i < kMathOps) {
                uint op = kMathBase + i * kMathWords;
                uint data = random_math(mix[prog[op]], mix[prog[op + 1u]],
                                        prog[op + 2u]);
                uint dst = prog[op + 3u];
                mix[dst] = random_merge(mix[dst], data, prog[op + 4u]);
            }
        }

        // A lane's four words are not its own quarter of the line: the
        // offset is (lane ^ r), so which lane reads which quarter changes every
        // round and the sixteen between them still cover all 256 bytes.
        uint word = line * kLineWords + ((lane ^ r) % kLanes) * kDagLoads;
        for (uint i = 0u; i < kDagLoads; i++) {
            uint op = kDagBase + i * kDagWords;
            uint dst = prog[op];
            mix[dst] = random_merge(mix[dst], shared_word(word + i),
                                    prog[op + 1u]);
        }
    }

    // The whole mix down to 16 words.
    uint lane_hash = kFnvOffsetBasis;
    for (uint i = 0u; i < kRegs; i++)
        lane_hash = fnv1a(lane_hash, mix[i]);

    kawpow_publish(lane_hash);

    // ...and 16 down to 8, where the lanes finally meet: lane l lands in word
    // l % 8, so each word takes two lanes in lane order.
    //
    // All sixteen lanes do this fold and fifteen throw it away. Only lane 0
    // emits, but a shuffle reads a register out of an invocation that must
    // still be running, so no lane may leave before the loop below is over.
    uint mix_hash[8];
    for (uint i = 0u; i < 8u; i++)
        mix_hash[i] = kFnvOffsetBasis;
    for (uint l = 0u; l < kLanes; l++)
        mix_hash[l % 8u] = fnv1a(mix_hash[l % 8u], kawpow_published(l));

    if (lane != 0u)
        return;

    // The final absorb carries the first keccak's digest forward rather than
    // the header: what a verifier is given is the mix hash and the nonce, and
    // it recomputes this half without touching the DAG at all.
    uint last[25];
    for (uint i = 0u; i < 8u; i++)
        last[i] = seed[i];
    for (uint i = 8u; i < 16u; i++)
        last[i] = mix_hash[i - 8u];
    progpow_absorb_final(last);
    keccak_f800(last);

    // Both a reversal and a byte swap. KawPoW's digest is eight
    // little-endian words and its first byte is the most significant of the
    // 256-bit number; the target comparison wants the most significant word
    // last, with its own bytes in place. So word j is word 7-j, swapped.
    uint state[8];
    for (uint j = 0u; j < 8u; j++)
        state[j] = bswap32(last[7u - j]);

    if (nonce_index >= push.count)
        return;

    probe_best(state[7]);

    if (state[7] > push.target[7])
        return;

    // The full 256-bit comparison, most significant word first. It repeats the
    // screen deliberately: the screen decides what to skip computing, this
    // decides what is a share.
    for (int i = 7; i >= 0; i--) {
        if (state[i] > push.target[i])
            return;
        if (state[i] < push.target[i])
            break;
    }

    emit_candidate64(push.capacity, nonce_lo, nonce_hi, state);
}
