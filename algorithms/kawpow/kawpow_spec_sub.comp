// KawPoW specialized, with the lanes meeting in each other's registers.
// SPDX-License-Identifier: GPL-3.0-or-later
//
// The kernel is kawpow_spec_body.glsl, the same text kawpow_spec.comp compiles;
// the macro below is the only difference, and shaders/common/kawpow_lanes.glsl
// is what it changes. The extensions are declared here because an #extension
// directive belongs at the top of a compilation unit.
//
// This module is not portable and is not meant to be. Declaring the shuffle
// capability at module scope is enough for a device without the feature to
// reject the whole thing, so kawpow.cpp offers it only where the device reports
// subgroupShuffle and a subgroup that is a whole number of sixteens -- which
// none of the software rasterizers are. It is an optimization that gets checked
// against the interpreter, not a peer of it.

#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#define KAWPOW_SUBGROUP_LANES 1

#include "algorithms/kawpow/kawpow_spec_body.glsl"
