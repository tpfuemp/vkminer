// x13 with native 64-bit lanes, for a device that reports shaderInt64.
// SPDX-License-Identifier: GPL-3.0-or-later
//
// Same kernel text as x13_32.comp. BLAKE, BMW, Skein, JH and Keccak take
// 64-bit words; the other eight stages are 32-bit either way.

#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#define VKMINER_BLAKE512_INT64 1
#define VKMINER_BMW_INT64 1
#define VKMINER_SKEIN_INT64 1
#define VKMINER_JH_INT64 1
#define VKMINER_SHA3_INT64 1

#include "algorithms/x13/x13_kernel.glsl"
