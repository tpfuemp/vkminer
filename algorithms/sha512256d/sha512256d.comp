// sha512256d with 64-bit adds, for a device that reports shaderInt64.
// SPDX-License-Identifier: GPL-3.0-or-later
//
// Same kernel text as sha512256d32.comp. Lanes are still uvec2 pairs, but each
// add goes through a uint64_t; see shaders/common/sha512.glsl.

#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#define VKMINER_SHA512_WIDE_ADD 1

#include "algorithms/sha512256d/sha512256d_kernel.glsl"
