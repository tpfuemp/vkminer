// sha512256d with 64-bit adds and each round's t1 summed left to right.
// SPDX-License-Identifier: GPL-3.0-or-later
//
// sha512256d.comp with one difference, the add order in t1; see S5D_T1 in
// sha512256d_kernel.glsl. Which of the two is faster depends on the GPU, so
// both are modules and the tuner picks.

#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#define VKMINER_SHA512_WIDE_ADD 1
#define SHA512256D_T1_LEFT_TO_RIGHT 1

#include "algorithms/sha512256d/sha512256d_kernel.glsl"
