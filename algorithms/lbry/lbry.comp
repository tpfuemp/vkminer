// lbry with 64-bit adds, for a device that reports shaderInt64.
// SPDX-License-Identifier: GPL-3.0-or-later
//
// The kernel is lbry_kernel.glsl, the same text lbry32.comp compiles; the two
// lines below are the whole of what decides what a SHA-512 lane is made of.
// Lanes are uvec2 pairs as in lbry32.comp, but each add goes through a
// uint64_t; see shaders/common/sha512.glsl.
// The extension is declared here because an #extension directive belongs at the
// top of a compilation unit, and because declaring it is precisely what a
// device without the feature rejects -- which is why this is two modules and
// not one shader with a specialization constant.

#version 450

#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#define VKMINER_SHA512_WIDE_ADD 1

#include "algorithms/lbry/lbry_kernel.glsl"
